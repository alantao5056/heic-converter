<Page
    x:Class="HeicToJpgBatchConverter.Main"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HeicToJpgBatchConverter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:c="using:Microsoft.Toolkit.Uwp.UI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <local:StatusToGlyphConverter x:Key="StatusToGlyphConverter" />
        <local:StatusToColorConverter x:Key="StatusToColorConverter" />
    </Page.Resources>

    <Grid>
        <TextBlock HorizontalAlignment="Left" Margin="10,24,0,0" TextWrapping="Wrap" Text="Source Folder" VerticalAlignment="Top"/>
        <TextBox Margin="105,18,230,0" 
                 TextWrapping="Wrap" 
                 VerticalAlignment="Top"
                 IsReadOnly="True"
                 Text="{x:Bind SourceFolderPath, Mode=OneWay}"/>
        <Button x:Name="btnSourceFolder" 
                Margin="0,17,185,0" 
                VerticalAlignment="Top" 
                HorizontalAlignment="Right"
                Click="btnSourceFolder_Click">
            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xED25;"/>
        </Button>
        <CheckBox x:Name="chbIncludeSubfolders" 
                  Content="Include subfolders" 
                  Margin="0,17,32,0" 
                  VerticalAlignment="Top" 
                  HorizontalAlignment="Right"
                  IsChecked="True"
                  Checked="chbIncludeSubfolders_Changed"
                  Unchecked="chbIncludeSubfolders_Changed"/>

        <TextBlock HorizontalAlignment="Left" 
                   Margin="10,57,0,0" 
                   TextWrapping="Wrap" 
                   Text="Target Folder" 
                   VerticalAlignment="Top"/>
        <TextBox x:Name="txbTargetFolderPath"
                 Margin="105,55,230,0" 
                 TextWrapping="Wrap"
                 VerticalAlignment="Top" 
                 IsReadOnly="True" 
                 Text="{x:Bind TargetFolderPath, Mode=OneWay}" />
        <Button x:Name="btnTargetFolder"
                Margin="0,54,185,0" 
                VerticalAlignment="Top" 
                HorizontalAlignment="Right"
                IsEnabled="{x:Bind SameAsSourceFolder, Mode=OneWay, Converter={StaticResource InverseBoolean}}"
                Click="btnTargetFolder_Click">
            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xED25;"/>
        </Button>
        <CheckBox x:Name="chbSameAsSourceFolder"
                  Content="Same as source folder" 
                  Margin="0,56,10,0" 
                  VerticalAlignment="Top" 
                  HorizontalAlignment="Right"
                  IsChecked="{x:Bind SameAsSourceFolder, Mode=TwoWay}"
                  Checked="chbSameAsSourceFolder_Changed"
                  Unchecked="chbSameAsSourceFolder_Changed"/>

        <c:DataGrid x:Name="fileList" 
                    BorderThickness="1" 
                    BorderBrush="#333333" Margin="10,150,10,133" 
                    ItemsSource="{x:Bind Files}"
                    AutoGenerateColumns="False">
            <c:DataGrid.Columns>
                <c:DataGridTemplateColumn Width="40">
                    <c:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox Margin="10,0,0,0" 
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                        </DataTemplate>
                    </c:DataGridTemplateColumn.CellTemplate>
                </c:DataGridTemplateColumn>
                <c:DataGridTextColumn Header="Path" 
                                      Width="*"
                                      Binding="{Binding Path}" 
                                      IsReadOnly="True" />
                <c:DataGridTextColumn Header="Date Taken" 
                                      Width="180"
                                      Binding="{Binding DateTaken}" 
                                      IsReadOnly="True" />
                <c:DataGridTextColumn Header="Original Name" 
                                      Width="Auto"
                                      MinWidth="150"
                                      Binding="{Binding OriginalName}" 
                                      IsReadOnly="True" />
                <c:DataGridTextColumn Header="Converted Name" 
                                      Width="Auto"
                                      MinWidth="150"
                                      Binding="{Binding ConvertedName}" 
                                      IsReadOnly="True" />
                <c:DataGridTemplateColumn Width="40" Header="Result">
                    <c:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <FontIcon FontFamily="Segoe MDL2 Assets" 
                                      Glyph="{Binding Status, Converter={StaticResource StatusToGlyphConverter}}"
                                      Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />
                        </DataTemplate>
                    </c:DataGridTemplateColumn.CellTemplate>
                </c:DataGridTemplateColumn>
            </c:DataGrid.Columns>
        </c:DataGrid>
        <Button x:Name="btnRemove"           
                Margin="0,112,10,0" 
                VerticalAlignment="Top"
                Click="btnRemove_Click" 
                HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xECC9;"/>
                <TextBlock Text="Remove" Margin="5 0 0 0"  />
            </StackPanel>
        </Button>
        <ComboBox x:Name="cmbOutputFormat"
                  Margin="10,0,0,72" 
                  Header="Output Format" 
                  VerticalAlignment="Bottom"
                  SelectedIndex="0"
                  SelectionChanged="cmbOutputFormat_SelectionChanged"
                  ItemsSource="{x:Bind ImageFormats, Mode=OneTime}" />
        <Slider x:Name="sliderJpgQuality"
                AutomationProperties.Name="Slider with ticks" 
                TickFrequency="10" 
                TickPlacement="Outside" Margin="217,0,10,71"
                Header="JPG Quality"
                Value="75" VerticalAlignment="Bottom"/>
        <ComboBox x:Name="cmbFileNameConflict"
                  Margin="10,0,0,10"  
                  VerticalAlignment="Bottom"
                  Header="File Name Conflict Resolution"
                  ItemsSource="{x:Bind CollisionResolutionSelectionItems, Mode=OneTime}"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Resolution"
                  SelectedIndex="0"/>
        <Button x:Name="btnStartConvert"
                Margin="11,112,0,0" 
                VerticalAlignment="Top"
                Click="btnStartConvert_Click">
            <StackPanel Orientation="Horizontal">
                <FontIcon FontFamily="Segoe MDL2 Assets" 
                          Glyph="&#xF5B0;" 
                          Foreground="{x:Bind StartButtonIconForeground, Mode=OneWay}"/>
                <TextBlock Text="Start Converting" Margin="5 0 0 0"  />
            </StackPanel>
        </Button>
    </Grid>
</Page>
